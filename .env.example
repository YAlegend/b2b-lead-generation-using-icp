# B2B Outreach Framework — Environment Variables
# ================================================
# Copy this file to .env and fill in your values.
# NEVER share .env or commit it to GitHub.
# It is already in .gitignore.

# ── LLM (choose one) ─────────────────────────────────
# Option 1: Ollama (free, local — recommended)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=nous-hermes2

# Option 2: Anthropic API (free $5 credit)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option 3: OpenAI API (free $5 credit)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Option 4: OpenRouter (pay per use, many models)
# OPENAI_API_KEY=sk-or-your-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=nousresearch/hermes-3-llama-3.1-70b

# ── Email finder ──────────────────────────────────────
# Sign up free at bettercontact.rocks (40 credits, no card)
BETTERCONTACT_API_KEY=your-bettercontact-key-here

# ── Sending Gmail ─────────────────────────────────────
# Use a DEDICATED Gmail — not your main inbox
# App password: myaccount.google.com/apppasswords
# (NOT your real Gmail password)
GMAIL_ADDRESS=your-outreach@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ── Company (set by wizard) ──────────────────────────
COMPANY_SLUG=my-company
COMPANY_URL=https://yourcompany.com
COMPANY_DESC=
